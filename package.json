{
  "name": "oneinstack-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --force --mode dev",
    "ll": "vite --force --mode ll",
    "ac": "vite --force --mode ac",
    "dev:test": "vite --force --mode test",
    "typecheck": "vue-tsc --noEmit",
    "buildNocnd": "npm run typecheck && vite build --mode pro",
    "build": "npm run typecheck && vite build --mode h5",
    "buildcdn": "npm run typecheck && vite build --mode cdn",
    "buildcdnlocal": "npm run typecheck && vite build --mode cdnlocal",
    "buildview": "npm run typecheck && vite build --mode proview",
    "preview": "vite preview",
    "format": "prettier --write . "
  },
  "dependencies": {
    "axios": "^1.13.2",
    "echarts": "5.6.0",
    "element-plus": "2.9.2",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qrcode.vue": "3.6.0",
    "tools-css": "1.0.3",
    "tools-javascript": "1.2.9",
    "tools-vue3": "2.0.9",
    "ui-vite": "1.1.8",
    "vue": "3.5.12",
    "vue-i18n": "10.0.4",
    "vue-router": "4.4.5",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@types/archiver": "6.0.2",
    "@types/node": "22.9.0",
    "@vitejs/plugin-vue": "4.6.2",
    "@vue/runtime-core": "3.5.12",
    "archiver": "7.0.1",
    "less": "4.2.0",
    "pinyin": "4.0.0-alpha.2",
    "prettier": "3.2.5",
    "terser": "5.36.0",
    "tools-mock": "2.0.8",
    "typescript": "5.6.3",
    "unplugin-auto-import": "0.18.3",
    "unplugin-vue-components": "0.27.4",
    "vite": "8.2.1",
    "vue-tsc": "2.1.10"
  },
  "description": "An project"
}
