{
  "name": "oneinstack-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --force --mode dev",
    "ll": "vite --force --mode ll",
    "ac": "vite --force --mode ac",
    "dev:test": "vite --force --mode test",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --test scripts/*.test.mjs",
    "buildNocnd": "npm run typecheck && vite build --mode pro",
    "build": "npm run typecheck && vite build --mode h5",
    "buildcdn": "npm run typecheck && vite build --mode cdn",
    "buildcdnlocal": "npm run typecheck && vite build --mode cdnlocal",
    "buildview": "npm run typecheck && vite build --mode proview",
    "preview": "vite preview",
    "format": "prettier --write . "
  },
  "dependencies": {
    "axios": "^1.20.0",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.5",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qrcode.vue": "3.6.0",
    "tools-css": "1.0.3",
    "tools-javascript": "1.2.9",
    "tools-vue3": "2.0.9",
    "ui-vite": "1.1.8",
    "vue": "3.5.12",
    "vue-i18n": "^11.4.10",
    "vue-router": "4.4.5",
    "xterm": "^5.3.0",
    "xterm-addon-canvas": "0.5.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@types/archiver": "6.0.2",
    "@types/node": "^22.20.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/runtime-core": "3.5.12",
    "archiver": "^8.0.0",
    "less": "^4.9.1",
    "pinyin": "4.0.0-alpha.2",
    "prettier": "3.2.5",
    "terser": "5.36.0",
    "tools-mock": "2.0.8",
    "typescript": "5.6.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.3.1",
    "vue-tsc": "^3.3.11",
    "ws": "^8.21.3"
  },
  "description": "An project"
}
